  "cards": [
    {
      "dot": "cyan",
      "title": "区别一:闸的位置",
      "items": [
        "v1:闸是 agent 服务里的中间件,只保护自家 4 个 worker",
        "网关:闸外置成独立服务,任何 agent 接入即被保护",
        "同一套闸,服务对象从「自己的 worker」泛化成「全企业任意 agent」"
      ]
    },
    {
      "dot": "emerald",
      "title": "区别二:谁是被治理对象",
      "items": [
        "v1:worker 是代码内子模块,没有身份,不是被治理对象",
        "网关:每个接入 agent 注册长期身份,票据/审批/审计都挂在身份上",
        "这就是白皮书七原则里的「资产域」,也是开源界的空白"
      ]
    },
    {
      "dot": "amber",
      "title": "迁移方式:抽件不搬仓",
      "items": [
        "verifyTicket 抽成 npm 包、proxy.py 逻辑 TS 重写、票面 fixture 拷贝",
        "soc-demo 不降格:它是网关的第一个客户,六幕剧本改走网关重跑",
        "网关不是 soc-demo 的一部分,soc-demo 只是网关的租户之一"
      ]
    }
  ]
