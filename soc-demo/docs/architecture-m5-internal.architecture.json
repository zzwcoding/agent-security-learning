  "cards": [
    {
      "dot": "cyan",
      "title": "技术栈",
      "items": [
        "LangGraph 子图工具循环：plan → 验票 → 执行 → 治理 → plan，直到 LLM 判定收工（PRD §6-M5）",
        "siem_query 强制 time_window——工具签名契约的一部分，防\"查全库\"式又贵又慢的查询",
        "上下文治理：结果 >10k 字符给 llm_summarize 小模型摘要，>50k 落盘留引用；小模型同样走凭证代理"
      ]
    },
    {
      "dot": "emerald",
      "title": "部署",
      "items": [
        "services/agent 内子模块 workers/investigation，无独立 HTTP 面",
        "SIEM 是 seam：fixture 告警集检索（演示）↔ 将来真 Wazuh，只换 adapter",
        "报告进 M2 Timeline，机读负载供 eval 评分与后续检索"
      ]
    },
    {
      "dot": "rose",
      "title": "铁律",
      "items": [
        "max_steps=20 用尽 → 输出部分报告并标注「调查不完整」——不装完整",
        "同参数重复调用同一工具 → 直接报错（防打转）；SIEM 0 命中 → 如实写「无关联事件」，不编造",
        "工具报错 → 计入 evidence 缺口继续（把拒绝当信息不当故障）；报告不合 schema → 重试 1 次 → 降级自由文本 + 标记"
      ]
    }
  ]
