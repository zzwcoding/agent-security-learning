 "cards": [
  {
   "dot": "cyan",
   "title": "技术栈",
   "items": [
    "TypeScript + Fastify 5（JSON Schema 校验内置，畸形请求白捡 422）",
    "tsx 直接跑 TS（骨架期不编译）；测试 vitest + app.inject 打 seam",
    "无 LLM——去重、映射、标记全是确定性代码"
   ]
  },
  {
   "dot": "emerald",
   "title": "部署",
   "items": [
    "compose 服务 ingest，单容器，端口 3001，健康检查 /healthz",
    "镜像 node:22-alpine；pnpm workspace 构建，packageManager 锁版本",
    "数据不落地在本服务——经 M2 REST 落 SQLite（唯一约束在 M2 侧兜底）"
   ]
  },
  {
   "dot": "rose",
   "title": "铁律",
   "items": [
    "告警只许外部推入，不许手工创建（TheHive 定位照抄）",
    "去重靠数据库唯一索引硬约束，不做应用层查-插（防并发重复）",
    "不可信标记入库即打，下游 prompt 装配消费这个标记"
   ]
  }
 ]
