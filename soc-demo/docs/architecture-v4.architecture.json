 "cards": [
  {
   "dot": "cyan",
   "title": "告警主流水线",
   "items": [
    "M1 接入去重 → M2 落库发事件 → M3 编排拉起 M4 分诊 → M5 调查 → M6 富化 → 响应建议",
    "L2 高危动作永远 interrupt 等人点头：审批通过铸一次性 ApprovalToken，用后焚毁",
    "M7 知识沉淀：案件关闭 → 提炼草稿 → 人审入库 → 下次分诊提速"
   ]
  },
  {
   "dot": "rose",
   "title": "安全控制面（差异化主体）",
   "items": [
    "LLM 永不见真实凭证：凭证代理在执行侧注入，全链路金丝雀断言",
    "验票闸强制执行：L0 免验 / L1 任务票 / L2 审批铸票，越权一律 403 + DENIED 审计",
    "子 agent 权限收窄：分诊 agent 物理上没有遏制工具的票",
    "注入双通道防护：llm-guard 文本扫描 + 验票行为兜底，纵深两层"
   ]
  },
  {
   "dot": "emerald",
   "title": "演示与评测",
   "items": [
    "M10 六页面薄客户端，全部功能 curl 可演（Web 消费 M2/M3/M8/M9 公开 API）",
    "M11 三维评估：分诊准确率 / 防线拦截率（四攻击面）/ 成本口径",
    "M12 MCP 体检 CLI 独立分发（不在本图 compose 内）"
   ]
  }
 ]
