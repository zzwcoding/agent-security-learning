{
  "name": "soc-demo",
  "private": true,
  "version": "0.1.0",
  "description": "SOC 数字员工：告警分诊与响应助手（路线 5 演示项目）",
  "packageManager": "pnpm@10.34.3",
  "type": "module",
  "scripts": {
    "lint": "eslint services packages evals",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:eval": "pnpm -C evals test:eval",
    "replay": "tsx scripts/replay.ts",
    "wazuh:feed": "tsx scripts/wazuh-logtest-feed.ts",
    "jiaotu:register": "tsx scripts/jiaotu-register.ts",
    "gen:tool": "node tools/gen-tool.mjs",
    "check:boundary": "python3 tools/check_boundary.py --self-test && python3 tools/check_boundary.py ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
