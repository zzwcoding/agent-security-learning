# 复制为 .env 使用（.env 已 gitignore 不入库）。未列出的变量一律吃 compose 内建默认。
# 口径（票 41-② / 票 06）：教学假值可跑通全链路；真部署删假值，由部署环境注入真值，
# 绝不放真密钥进仓库。

# 铸票/会话 HMAC 钥：gateway（铸票）与 agent（验票）共享同一枚；缺失 = 拒铸票/拒登录
# （fail-closed，INV-1）。本地演示用教学假值即可。
SOC_HMAC_KEY=local-demo-hmac-key-not-for-prod

# LLM 模式（票 27）：fake = 离线伪 LLM，verdict 确定性（默认演示口径）；
# real = 经网关凭证代理真出站，需配 SECRETS_LLM_API_KEY。
AGENT_LLM=fake
LLM_MODEL=minimax-m2

# 仅 AGENT_LLM=real 时需要：上游地址与真 key。key 只挂 gateway 进程，绝不进 agent。
SOC_LLM_UPSTREAM=https://api.minimaxi.com
SECRETS_LLM_API_KEY=
