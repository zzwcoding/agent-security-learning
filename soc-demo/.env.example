# 复制为 .env 使用（.env 已 gitignore 不入库）。未列出的变量一律吃 compose 内建默认。
# 口径（票 41-② / 票 06）：教学假值可跑通全链路；真部署删假值，由部署环境注入真值，
# 绝不放真密钥进仓库。

# 铸票/会话 HMAC 钥：gateway（铸票）与 agent（验票）共享同一枚；缺失 = 拒铸票/拒登录
# （fail-closed，INV-1）。本地演示用教学假值即可。
SOC_HMAC_KEY=local-demo-hmac-key-not-for-prod

# LLM 模式（票 27）：fake = 离线伪 LLM，verdict 确定性（默认演示口径）；
# real = 经网关凭证代理真出站，需配 SECRETS_LLM_API_KEY。
AGENT_LLM=fake
LLM_MODEL=minimax-m2

# 仅 AGENT_LLM=real 时需要：上游地址与真 key。key 只挂 gateway 进程，绝不进 agent。
SOC_LLM_UPSTREAM=https://api.minimaxi.com
SECRETS_LLM_API_KEY=

# Langfuse 可选观测（票 37）：默认注释掉 = 镜像旁路不启用（key 是唯一开关，ADR 0001
# 默认链路零改动）。要看 trace 才解开：先 docker compose --profile observability up -d langfuse，
# 再配下面两行重启 agent。key 是 compose 首启种下的教学假值，仅本地用。
# LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
# LANGFUSE_SECRET_KEY=sk-lf-local-demo

# ── 狗粮票 59：jiaotu 形态（椒图全外接；下面四行全不设 = 内部模式零变化）────────
# 椒图检出路径（jiaotu-gateway 构建上下文 + upstream-stub 挂载源）。缺省 ../agentjiaotu
# （主工作区布局）；git worktree 检出里没有该目录，必须设成主工作区检出，例：
#   JIAOTU_REPO_PATH=/Users/divh/Downloads/安全评估agent/agentjiaotu
#JIAOTU_REPO_PATH=../agentjiaotu

# soc-demo 在椒图侧的 agent api_key（scripts/jiaotu-register.ts 注册时写入 .env，明文
# 仅注册响应出现一次；丢了换 --name 重注册）。agent 容器靠它对椒图附 Bearer（G1）。
#JIAOTU_API_KEY=

# 真网 LLM 上游（--real-llm 可选环节用；默认不设 = upstream-stub 假上游，不出网）。
# 值含 /v1：椒图出站拼法 ${UPSTREAM}/chat/completions，例：
#   JIAOTU_LLM_UPSTREAM=https://api.minimaxi.com/v1
#JIAOTU_LLM_UPSTREAM=

# 真网时上游 provider 授权（椒图票 13：UPSTREAM_AUTHORIZATION，支持 ${{ SECRETS.* }}
# 占位符、出站瞬间注入 authorization 头；upstream-stub 不验头，fake 形态留空）。
#JIAOTU_UPSTREAM_AUTHORIZATION=

# ── 票 68：under-pressure 过载卸载（ingest / case-backend / agent 三个 Fastify 服务）────
# UNDER_PRESSURE=on 才注册 @fastify/under-pressure；缺省不设 = off = 零注册，默认形态
# 逐字节不变。on 时阈值给教学演示量级保守值（插件官方缺省 0 = 该项不检查），可逐项覆盖；
# 压测对照复现见 docs/research/2026-09-12-压力测试报告.md B2/B4 的 under-pressure 小节。
#UNDER_PRESSURE=on
#UNDER_PRESSURE_MAX_EVENT_LOOP_DELAY_MS=1000
#UNDER_PRESSURE_MAX_HEAP_USED_BYTES=1073741824
#UNDER_PRESSURE_MAX_RSS_BYTES=1610612736
