{
  "template_id": "hunt_credential_leak",
  "family": "credential_leak",
  "title": "凭据文件篡改与外带外联",
  "hypothesis_patterns": [
    "怀疑主机 {host} 的凭据文件 {path} 被读取或篡改并外带。"
  ],
  "menu": ["playbook_lookup", "graph_query", "file_change_query", "outbound_conn_query"],
  "max_rounds": 6,
  "max_tasks": 2,
  "default_time_window": { "from": "2023-04-25T00:00:00.000Z", "to": "2023-04-26T00:00:00.000Z" },
  "example_slots": { "host": "centos7", "path": "/etc/shadow" },
  "waves": [
    [
      { "tool": "playbook_lookup", "params": { "tag": "credential_leak" }, "rationale": "开局先调剧本库，锚定凭据泄露狩猎的取证面（剧本/图谱开局是狩猎 plan 起手式）" },
      { "tool": "file_change_query", "params": { "field": "path", "value": "{path}", "time_window": "{time_window}" }, "rationale": "按凭据文件路径查 FIM 篡改证据（强制 time_window）" }
    ],
    [
      { "tool": "outbound_conn_query", "params": { "field": "domain", "value": "exfil.evil-baseline.example", "time_window": "{time_window}" }, "rationale": "换维度补查：按外带域名查外联（C2/外带维度）" },
      { "tool": "graph_query", "params": { "entity": "{host}" }, "rationale": "并行查关系图（approved 态关系——主机已知情报佐证）" }
    ]
  ]
}
