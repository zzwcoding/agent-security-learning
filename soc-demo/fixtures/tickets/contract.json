{
  "contract_version": 1,
  "source": "ADR 0001 · PRD §5.8/§5.9 · specs/modules.md m9 卡 Seam",
  "hmac_key": {
    "alg": "HS256",
    "encoding": "utf8",
    "value": "soc-demo-test-hmac-key-do-not-use-in-prod",
    "note": "测试固定密钥，仅 fixtures/tickets/ 契约测试可用，禁入真实环境"
  },
  "token_format": {
    "wire": "<b64url(header)>.<b64url(payload)>.<hex(hmac_sha256(key, 'b64h.b64p'))>",
    "b64url": "去 padding；payload 序列化 = json.dumps(ensure_ascii=False) 默认分隔符",
    "header": {
      "alg": "HS256",
      "typ": "JWT"
    },
    "sig": "hex 摘要（继承 task_token.py，非 JWT 标准的 b64 段）"
  },
  "params_hash": {
    "canonical": "sha256(utf8(json.dumps(params, ensure_ascii=False, sort_keys=True, separators=(',',':'))))",
    "prefix": "sha256:"
  },
  "clock": {
    "policy": "验票实现必须支持注入当前时间；契约测试一律用 fixture.verify_now，禁用 wall clock"
  },
  "reasons": [
    "allow",
    "no_ticket",
    "scope_insufficient",
    "token_expired",
    "token_used",
    "params_mismatch",
    "require_approval",
    "signature_invalid"
  ],
  "reasons_note": "前七个照 PRD FR-S2.2 verifyTicket 契约（allow 加上六种 403）；signature_invalid 为本契约扩展——签名不符不在 PRD 六种 reason 内，作为 fail-closed 第一关单列，票 07 落地时纳入 reason 联合。no_ticket/require_approval 是闸控制流，不由票面 fixture 覆盖。",
  "cases": [
